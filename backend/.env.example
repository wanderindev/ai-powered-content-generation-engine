# Local development environment template for backend.
# Copy to backend/.env and fill in values. For production, see ../.env.example.
# Variable names must match what backend/app/core/config.py reads
# (pydantic-settings is case-insensitive).

# Application
APP_NAME="Panama In Context API"
DEBUG=true
# ENVIRONMENT gates Sentry init (events are never sent when "test")
# ENVIRONMENT=development

# Error reporting (Sentry). Unset in dev/CI -> Sentry init is a no-op.
# SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<backend-project-id>

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# CORS - JSON array, no surrounding quotes
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Languages
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=["es","en"]

# DeepL API
DEEPL_API=your-api-key

# Tour Booking System
FRONTEND_URL=http://localhost:5173
ADMIN_NOTIFICATION_EMAIL=diego@panamaincontext.com
SENDER_EMAIL=diego@panamaincontext.com

# SMTP relay for outbound email (Google Workspace smtp-relay.gmail.com is
# IP-allowlisted, no auth). Point at a local capture tool (e.g. MailHog) in dev.
SMTP_RELAY_HOST=smtp-relay.gmail.com
SMTP_RELAY_PORT=587
SMTP_RELAY_TIMEOUT=10

# Admin emails (comma-separated list of authorized admin emails)
ADMIN_EMAILS=admin@example.com

# Object storage — local dev defaults point at the MinIO sidecar in
# docker-compose.yml (writes land in ./local-storage/ on the host).
# To debug against real DO Spaces, swap KEY/SECRET to a prod-tier set and
# point ENDPOINT/CDN_URL at https://nyc3.digitaloceanspaces.com /
# https://panamaincontext.nyc3.digitaloceanspaces.com — but be aware that
# any pipeline that calls upload_image() will then write to the live bucket.
DO_SPACES_KEY=minioadmin
DO_SPACES_SECRET=minioadmin
DO_SPACES_BUCKET=panamaincontext
DO_SPACES_REGION=us-east-1
DO_SPACES_ENDPOINT=http://minio:9000
DO_SPACES_CDN_URL=http://localhost:9000/panamaincontext

# OpenAI
OPENAI_API_KEY=sk-proj-your-openai-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key

# ElevenLabs (voice narration for slide presentations)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_DIEGO=your-elevenlabs-voice-id

# Instagram Graph API publishing. Empty credentials = publisher disabled
# (publish endpoints answer 503, scheduler no-ops; everything upstream works).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_GRAPH_API_URL=https://graph.facebook.com/v23.0
# INSTAGRAM_SCHEDULER_ENABLED=true
# INSTAGRAM_SCHEDULER_INTERVAL_SECONDS=60

# PayPal (webhook verification + checkout). PAYPAL_API_URL defaults to sandbox;
# set to https://api-m.paypal.com for production.
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_BUSINESS_EMAIL=diego@panamaincontext.com
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Optional tuning knobs (sensible defaults in app/core/config.py):
# ANTHROPIC_BUDGET_INPUT_TOKENS=20000000
# ANTHROPIC_TIMEOUT_SECONDS=120
# ANTHROPIC_STREAM_TIMEOUT_SECONDS=600
# ANTHROPIC_STREAM_MIN_TOKENS=8000
# MEDIA_HTTP_TIMEOUT=60
# MEDIA_HTTP_MAX_RETRIES=3
# LOC_RATE_LIMIT_SECONDS=3
# WIKIMEDIA_RATE_LIMIT_SECONDS=1
