        "casco_plazas": {
            "title": "Casco Antiguo: Plazas e Iglesias",
            "desc": "Explore el Casco Antiguo, un museo viviente reconocido por la UNESCO donde la arquitectura colonial narra la evolución de la nación. Visite magníficas plazas e iglesias históricas que representan el viaje de Panamá de colonia a república independiente.",
            "details": {
                "description_1": "Los estudiantes entran en el museo viviente de Panamá explorando el Casco Antiguo, reconocido por la UNESCO, donde calles adoquinadas y arquitectura colonial cuentan la evolución del país. Este recorrido inmersivo guía a los estudiantes por magníficas plazas e iglesias históricas, cada una representando capítulos cruciales en el tránsito de Panamá de colonia española a república independiente.",
                "description_2": "3 horas de exploración guiada disponible en Español e Inglés",
                "highlights_title": "Puntos Destacados",
                "adaptations_title": "Adaptaciones Curriculares",
                "highlights": [
                    {
                        "category": "Principales Plazas",
                        "items": "Plaza Mayor, Plaza Bolívar, Plaza de Francia, Plaza Herrera"
                    },
                    {
                        "category": "Iglesias Históricas",
                        "items": "Catedral Metropolitana, Iglesia de La Merced, Iglesia de San José, Iglesia de San Francisco, Iglesia de Santo Domingo, Oratorio San Felipe Neri"
                    },
                    {
                        "category": "Sitios Culturales",
                        "items": "Teatro Nacional, Palacio Bolívar, Antiguo Muro Marino"
                    }
                ],
                "adaptations": [
                    {
                        "grade": "3º - 6º Grado",
                        "desc": "Enfoque en características arquitectura, secuencia histórica básica, y la importancia estratégica de Panamá."
                    },
                    {
                        "grade": "7º - 8º Grado",
                        "desc": "Examinar los movimientos independentistas, la visión de Bolívar y el Congreso Anfictiónico."
                    },
                    {
                        "grade": "9º - 12º Grado",
                        "desc": "Examinar las fuerzas geopolíticas detrás de la independencia de Panamá de 1903 y realizar un análisis comparativo de narrativas históricas panameñas, colombianas y estadounidenses."
                    }
                ]
            }
        },
        "casco_museums": {
            "title": "Casco Antiguo: Circuito de Museos",
            "desc": "Exploración guiada por museos seleccionados que siguen la evolución histórica panameña desde colonia española hasta república moderna.",
            "details": {
                "description_1": "Exploración guiada por museos seleccionados que siguen la evolución histórica panameña desde colonia española hasta república moderna, adaptada a su currículo.",
                "description_2": "3 horas de exploración guiada disponible en Español e Inglés",
                "highlights_title": "Seleccione 3 Museos",
                "highlights": [
