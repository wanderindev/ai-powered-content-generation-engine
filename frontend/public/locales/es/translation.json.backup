        "value_prop": {
            "eyebrow": "¿Por Qué Elegirnos?",
            "title": "Educación Más Allá del Aula",
            "description": "Resolvemos los desafíos de las excursiones tradicionales (mala acústica, falta de contexto y dificultades en el manejo del grupo) ofreciendo una experiencia académica completa apoyada en tecnología.",
            "quote": "Diego estuvo a cargo de guiar a nuestros estudiantes de quinto grado en una excursión escolar al Casco Viejo. No solo es muy conocedor del tema, sino que también mantuvo su atención con anécdotas e información interesante que no se encuentra en los libros de texto. Con el equipo de audio, pudo manejar fácilmente a los 85 niños de diez años durante la excursión.",
            "author": "Montgomery J",
            "columns_intro": "Las excursiones tradicionales a menudo carecen de contexto y se convierten en simples paseos turísticos. Nuestro enfoque asegura objetivos de aprendizaje claros, haciendo de la visita una valiosa extensión de su plan de estudios.",
            "columns_outro": "Nos enfocamos en la experiencia educativa, brindándole todas las herramientas académicas que necesita para una excursión exitosa.",
            "features": {
                "audio": {
                    "title": "Tecnología de Audio.",
                    "desc": "Cada estudiante escucha toda la visita mediante receptores Bluetooth ligeros, asegurando un 100% de participación y facilitando el manejo del grupo."
                },
                "engagement": {
                    "title": "Mayor Retención.",
                    "desc": "Nuestra metodología de exposición múltiple mejora significativamente la retención de información histórica y el pensamiento crítico."
                },
                "curriculum": {
                    "title": "Alineado al Currículo.",
                    "desc": "Contenido adaptado a su nivel de grado específico y estándares curriculares."
                }
            }
        },
        "methodology": {
            "title": "Nuestra Metodología de Aprendizaje",
            "description": "Un proceso de tres pasos diseñado para maximizar la retención y el compromiso.",
            "steps": {
                "context": {
                    "title": "1. Pre-Visita: Contexto",
                    "desc": "Ofrecemos una sesión virtual por Zoom para preparar el terreno. Brindamos contexto, vocabulario y preguntas de indagación para despertar la curiosidad antes de la visita."
                },
                "immersion": {
                    "title": "2. La Excursión: Inmersión",
                    "desc": "Una visita guiada inmersiva con tecnología de audio premium. Los estudiantes escuchan claramente, permitiendo una mayor conexión con el contenido histórico."
                },
                "reflection": {
                    "title": "3. Post-Visita: Reflexión",
                    "desc": "Proporcionamos una guía de estudio adaptada al nivel de grado para sintetizar el aprendizaje en el aula y reforzar los nuevos conocimientos."
                }
            }
        },
