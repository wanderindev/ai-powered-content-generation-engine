                        "items": "Transición del período colonial al republicano en el Palacio Municipal"
                    },
                    {
                        "category": "Museo de la Mola",
                        "items": "Arte indígena y expresión cultural"
                    },
                    {
                        "category": "Museo de La Merced",
                        "items": "Patrimonio religioso colonial"
                    },
                    {
                        "category": "Palacio Bolívar",
                        "items": "Documentos históricos, regalos diplomáticos, y la Biblioteca Roberto F. Chiari"
                    }
                ],
                "adaptations_title": "Adaptaciones Curriculares",
                "adaptations": [
                    {
                        "grade": "3º - 6º Grado",
                        "desc": "Participar con exhibiciones interactivas sobre nuestro diverso patrimonio cultural y aprender sobre la independencia de Panamá."
                    },
                    {
                        "grade": "7º - 8º Grado",
                        "desc": "Evaluar críticamente cómo la ubicación estratégica de Panamá moldeó su desarrollo histórico."
                    },
                    {
                        "grade": "9º - 12º Grado",
                        "desc": "Explorar cómo la posición única de Panamá creó relaciones políticas y económicas complejas con potencias globales, particularmente España, Colombia, y Estados Unidos."
                    }
                ]
            }
