        "casco_museums": {
            "title": "Casco Antiguo: Circuito de Museos",
            "desc": "Trace la evolución de Panamá a través de visitas curadas a museos—desde el arte indígena hasta la ambición ingenieril que conectó dos océanos.",
            "details": {
                "title": "La Experiencia del Circuito de Museos",
                "description_1": "Descubra la extraordinaria historia de Panamá a través de sus mejores museos, todos ubicados dentro del histórico Casco Antiguo. Este recorrido curado lo lleva desde tesoros precolombinos hasta el audaz sueño de conectar dos océanos, revelando cómo un pequeño istmo se convirtió en una de las encrucijadas más estratégicas del mundo.",
                "description_2": "Aproximadamente 4 horas incluyendo visitas a museos. Disponible en inglés y español.",
                "highlights_title": "Aspectos Destacados",
                "highlights": [
                    {
                        "title": "Museo del Canal de Panamá",
                        "desc": "Ubicado en la sede original de la Compañía Francesa del Canal, explore la odisea de la construcción del canal—desde la tragedia francesa hasta el triunfo estadounidense y la eventual soberanía de Panamá sobre esta maravilla de la ingeniería."
                    },
                    {
                        "title": "Museo de Historia",
                        "desc": "Recorra la transformación de Panamá de colonia española a nación independiente, con artefactos y documentos que traen cinco siglos de historia a la vida."
                    },
                    {
                        "title": "Iglesia de La Merced y Su Campana",
                        "desc": "Visite una de las iglesias más históricas de Panamá y vea la campana original que fue rescatada de Panamá Viejo después del ataque pirata de 1671."
                    },
                    {
                        "title": "Patrimonio Indígena",
                        "desc": "Aprecie el arte de los pueblos indígenas de Panamá a través de exquisitas molas, artesanías tradicionales y piezas arqueológicas que anteceden el contacto europeo."
                    }
                ],
                "includes_title": "Qué Incluye",
                "includes": [
                    "Guía experto bilingüe",
                    "Todas las entradas a museos",
                    "Agua embotellada",
                    "Ritmo cómodo con pausas de descanso",
                    "Transporte privado opcional desde su hotel"
                ]
            }
        },
        "panama_viejo": {
            "title": "Panamá Viejo: Sitio Arqueológico",
            "desc": "Camine por las calles excavadas de la capital original de Panamá, fundada en 1519 y destruida por piratas en 1671. Suba a la torre de la catedral para vistas panorámicas.",
            "details": {
                "title": "Donde Comenzó Panamá",
                "description_1": "Recorra las solemnes ruinas de la primera ciudad europea en la costa del Pacífico de las Américas. Fundada en 1519 y destruida por el infame pirata Henry Morgan en 1671, Panamá Viejo se erige como un poderoso testimonio de la ambición colonial, la resistencia indígena y los dramáticos eventos que moldearon el Nuevo Mundo.",
                "description_2": "Aproximadamente 2.5 horas incluyendo museo y subida a la torre. Disponible en inglés y español.",
                "highlights_title": "Aspectos Destacados",
                "highlights": [
                    {
                        "title": "La Torre de la Catedral",
                        "desc": "Suba la icónica torre del campanario—el monumento más fotografiado de Panamá—para disfrutar de impresionantes vistas panorámicas que se extienden desde las antiguas ruinas hasta el horizonte moderno, capturando perfectamente 500 años de historia en una sola mirada."
                    },
                    {
                        "title": "El Ataque Pirata de 1671",
                        "desc": "Ubíquese donde se desarrolló el asalto más dramático de la historia mientras su guía relata el devastador ataque de Henry Morgan y la desesperada decisión de quemar la ciudad antes que entregar sus tesoros."
                    },
                    {
                        "title": "Descubrimientos Arqueológicos",
                        "desc": "Explore calles excavadas, conventos y plazas mientras aprende sobre el trabajo arqueológico en curso que continúa revelando secretos de la vida colonial y de los pueblos indígenas que vivieron aquí antes."
                    },
                    {
                        "title": "El Museo del Sitio",
                        "desc": "Observe artefactos recuperados de las ruinas, maquetas que muestran la ciudad en su apogeo y exhibiciones que traen a la vida la cotidianidad de esta próspera capital colonial."
                    }
                ],
                "includes_title": "Qué Incluye",
                "includes": [
                    "Guía experto bilingüe",
                    "Entradas al sitio y museo",
                    "Acceso a la torre",
                    "Agua embotellada",
                    "Transporte privado opcional desde su hotel"
                ]
            }
        },
        "mi_pueblito": {
            "title": "Mi Pueblito: Patrimonio Cultural",
            "desc": "Experimente las diversas tradiciones culturales de Panamá en este museo viviente que muestra la arquitectura y costumbres de las tres raíces fundacionales del país.",
            "details": {
                "title": "Las Tres Raíces de Panamá",
                "description_1": "Viaje al corazón del ADN cultural de Panamá en este singular museo al aire libre en las laderas del Cerro Ancón. Mi Pueblito reúne las tres identidades fundacionales de la nación—las tradiciones Campesinas del Interior, el legado Afroantillano de los constructores del Canal, y la herencia Indígena que los precede a todos—en una experiencia que revela cómo estas diversas raíces se entrelazaron para crear el Panamá moderno.",
                "description_2": "Aproximadamente 2.5 horas de exploración guiada. Disponible en inglés y español.",
                "highlights_title": "Aspectos Destacados",
                "highlights": [
                    {
                        "title": "El Museo de la Pollera",
                        "desc": "Descubra el icónico traje nacional de Panamá—considerado uno de los más bellos e intrincados del mundo. Su guía decodifica el simbolismo del encaje artesanal, los relucientes tembleques, y por qué una sola Pollera de Gala puede tomar un año en crearse."
                    },
                    {
                        "title": "El Pueblo Campesino",
                        "desc": "Camine por réplicas de las tradicionales casas de quincha de la Península de Azuero. Conozca la Junta de Embarre—la tradición comunitaria de construcción donde pueblos enteros se reunían a pisar el barro y la paja mientras celebraban con música y seco."
                    },
                    {
                        "title": "El Barrio Afroantillano",
                        "desc": "Adéntrese en la colorida arquitectura de madera de la era del Canal, incluyendo la Casa Müller en forma de barco. Comprenda el sistema de segregación Gold Roll vs. Silver Roll y cómo los trabajadores antillanos transformaron el panorama cultural de Panamá."
                    },
                    {
                        "title": "Encuentro con Artesanos Indígenas",
                        "desc": "Conozca artesanos Guna y Emberá elaborando molas tradicionales y tallas de tagua. No son meros recuerdos—las molas son mapas cosmológicos, y el tallado de tagua es un arte centenario transmitido por generaciones."
                    }
                ],
                "includes_title": "Qué Incluye",
                "includes": [
                    "Guía experto bilingüe",
                    "Entrada al sitio",
                    "Acceso al Museo de la Pollera",
                    "Agua embotellada",
                    "Transporte privado opcional desde su hotel"
                ]
            }
        },
        "biomuseo": {
            "title": "Biomuseo: Museo de la Biodiversidad",
            "desc": "Dentro de la obra maestra arquitectónica de Frank Gehry, descubra cómo el surgimiento de Panamá cambió la biología de la Tierra al conectar dos continentes.",
            "details": {
                "title": "Donde Colisionan los Continentes",
                "description_1": "Entre a la única obra de Frank Gehry en Latinoamérica—un estallido de color en el malecón de la Ciudad de Panamá—y descubra cómo un pequeño puente terrestre cambió el curso de la vida en la Tierra. El Biomuseo cuenta la extraordinaria historia de cómo el surgimiento de Panamá del mar hace tres millones de años desencadenó el Gran Intercambio Biótico Americano, transformando para siempre la biología de dos continentes.",
                "description_2": "Aproximadamente 2.5 horas incluyendo todas las galerías. Disponible en inglés y español.",
                "highlights_title": "Aspectos Destacados",
                "highlights": [
                    {
                        "title": "La Visión Arquitectónica de Gehry",
                        "desc": "Experimente el único edificio que Frank Gehry diseñó en Latinoamérica, donde vibrantes marquesinas de metal plegado evocan la biodiversidad tropical en su interior. Su guía explica cómo la arquitectura misma cuenta la historia de la abundancia natural de Panamá."
                    },
                    {
                        "title": "El Puente de Vida",
                        "desc": "Comprenda cómo el surgimiento de Panamá creó una superautopista biológica. Cuando Norte y Sudamérica se conectaron, las especies migraron en ambas direcciones—los armadillos fueron hacia el norte mientras los grandes felinos se movieron hacia el sur, reconfigurando ecosistemas en dos continentes."
                    },
                    {
                        "title": "Océano Dividido, Vida Transformada",
                        "desc": "Explore cómo el istmo dividió un gran océano en el Atlántico y el Pacífico, creando nuevas corrientes, cambiando climas y aislando especies marinas que antes nadaban libremente entre los mares."
                    },
                    {
                        "title": "Los Tesoros Vivientes de Panamá",
                        "desc": "Desde el acuario que muestra ambos ecosistemas oceánicos hasta galerías que celebran la increíble biodiversidad de Panamá, descubra por qué esta pequeña nación alberga más especies que Estados Unidos y Canadá juntos."
                    }
                ],
                "includes_title": "Qué Incluye",
                "includes": [
                    "Guía experto bilingüe",
                    "Entrada al museo",
                    "Acceso a todas las galerías permanentes",
                    "Agua embotellada",
                    "Transporte privado opcional desde su hotel"
                ]
            }
        },
