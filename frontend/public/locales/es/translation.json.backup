        "panama_viejo": {
            "title": "Complejo Arqueológico de Panamá Viejo",
            "desc": "Camine sobre las calles excavadas del primer asentamiento europeo en la costa del Pacífico, fundado en 1519. Explore las ruinas de este próspero centro colonial destruido por el pirata Henry Morgan en 1671.",
            "details": {
                "description_1": "Los estudiantes caminan directamente sobre las calles excavadas de la capital original de Panamá, fundada en 1519 como el primer asentamiento europeo en la costa del Pacífico de las Américas. Este sitio arqueológico inmersivo permite a los estudiantes explorar físicamente las ruinas de este próspero centro colonial, destruido por el pirata Henry Morgan en 1671. Los estudiantes suben a la Torre de la Catedral restaurada para vistas panorámicas mientras aprenden cómo los arqueólogos reconstruyen narrativas históricas a partir de evidencia física.",
                "description_2": "3 horas de exploración guiada disponible en Español e Inglés",
                "highlights_title": "Lugares destacados",
                "highlights": [
                    {
                        "category": "Ruinas de la Catedral",
                        "items": "Ruinas de la catedral y torre del campanario (con ascenso opcional)"
                    },
                    {
                        "category": "Edificios Públicos",
                        "items": "Fundaciones del edificio del cabildo (ayuntamiento)"
                    },
                    {
                        "category": "Vida Cotidiana",
                        "items": "Antiguo complejo de cisternas y restos del convento de las Monjas de la Divina Concepción"
                    },
                    {
                        "category": "Estructuras Civiles",
                        "items": "Área del mercado y barrios residenciales"
                    },
                    {
                        "category": "Museo",
                        "items": "Museo de la Plaza Mayor con artefactos auténticos"
                    }
                ],
                "adaptations_title": "Adaptaciones Curriculares",
                "adaptations": [
                    {
                        "grade": "3º - 6º Grado",
                        "desc": "Enfoque en conceptos arqueológicos básicos y vida colonial."
                    },
                    {
                        "grade": "7º - 8º Grado",
                        "desc": "Examinar redes comerciales y el impacto de la piratería en patrones de asentamiento."
                    },
                    {
                        "grade": "9º - 12º Grado",
                        "desc": "Explorar cómo Panamá Viejo funcionó como área de preparación para la conquista del Imperio Inca por Francisco Pizarro, analizando la logística de la expedición y preguntas éticas sobre la colonización."
                    }
                ]
            }
        },
        "biomuseo": {
            "title": "Museo de la Biodiversidad",
            "desc": "Dentro de la única obra maestra arquitectónica latinoamericana de Frank Gehry, descubra cómo Panamá cambió literalmente la biología de la Tierra al unir dos continentes.",
            "details": {
                "description_1": "Dentro de la única obra maestra arquitectónica latinoamericana de Frank Gehry, los estudiantes descubren cómo Panamá literalmente cambió la biología de la Tierra al unir dos continentes y dividir un vasto océano. A través de exhibiciones dinámicas e interactivas, los estudiantes investigan cómo este estrecho istmo desencadenó uno de los eventos de biodiversidad más significativos en la historia de la Tierra: el Gran Intercambio Biótico Americano.",
                "description_2": "2-3 horas de exploración guiada disponible en Español e Inglés",
                "highlights_title": "Destacados",
                "highlights": [
                    {
                        "category": "Panamarama",
                        "items": "Rodea a los estudiantes con 10 pantallas mostrando los diversos ecosistemas de Panamá"
                    },
                    {
                        "category": "El Puente Surge",
                        "items": "Examen de formaciones geológicas reales mostrando cómo la actividad volcánica creó el istmo"
                    },
                    {
                        "category": "El Gran Intercambio",
                        "items": "Demuestra la migración de especies entre continentes con modelos de tamaño real"
                    },
                    {
                        "category": "La Huella Humana",
                        "items": "Rastrea 15,000 años de impacto humano en el medio ambiente de Panamá"
                    },
                    {
                        "category": "Océanos Divididos",
                        "items": "Usa acuarios gemelos para mostrar cómo especies marinas idénticas evolucionaron diferentemente cuando se separaron"
                    }
                ],
                "adaptations_title": "Adaptaciones Curriculares",
                "adaptations": [
                    {
                        "grade": "3º - 6º Grado",
                        "desc": "Enfoque en biodiversidad observable y conceptos ecológicos básicos."
                    },
                    {
                        "grade": "7º - 8º Grado",
                        "desc": "Explorar adaptación de especies, geología, y sistemas biológicos complejos."
                    },
                    {
                        "grade": "9º - 12º Grado",
                        "desc": "Examinar investigación actual sobre impactos del cambio climático en la biodiversidad de Panamá. Analizar datos mostrando cómo la creación del istmo alteró corrientes oceánicas globales y patrones climáticos."
                    }
                ]
            }
        },
        "miraflores": {
            "title": "Centro de Visitantes Miraflores e IMAX",
            "desc": "Sea testigo de la maravilla de la ingeniería del Canal de Panamá mientras enormes barcos navegan las esclusas. Perfecta para estudiantes de 4° a 6° grado.",
            "details": {
                "description_1": "Perfecta para estudiantes de 4° a 6° grado, esta excursión transforma conceptos abstractos de ingeniería y comercio global en fenómenos tangibles y observables mientras barcos que pesan miles de toneladas navegan las legendarias esclusas del Canal de Panamá. Los estudiantes presencian el \"Ballet de Miraflores\" mientras compuertas masivas se abren y cierran, el agua se llena y vacía, y \"mulas\" eléctricas guían embarcaciones a través de operaciones de precisión que demuestran principios fundamentales de ciencias físicas.",
                "description_2": "2 horas de exploración guiada disponible en Español e Inglés",
                "highlights_title": "Destacados",
                "highlights": [
                    {
                        "category": "Herramientas de Ingeniería",
                        "items": "Comparar herramientas de construcción del canal con contrapartes modernas"
                    },
                    {
                        "category": "Identificación de Barcos",
                        "items": "Identificar barcos por bandera de país, tipo de carga y dimensiones"
                    },
                    {
                        "category": "Plataforma de Observación",
                        "items": "Observar tránsitos de barcos desde la plataforma de observación"
                    },
                    {
                        "category": "Experiencia IMAX",
                        "items": "\"A Land Divided, A World United\" experiencia IMAX"
                    }
                ],
                "adaptations_title": "Niveles Recomendados",
                "adaptations": [
                    {
                        "grade": "4º - 6º Grado",
                        "desc": "Los materiales educativos incorporan ciencias, historia y economía global en formatos apropiados para la edad."
                    }
                ]
            }
        },
        "religious": {
            "title": "Jornada Inter-Religiosa de Panamá",
            "desc": "Explore la notable diversidad religiosa de Panamá y obtenga una comprensión profunda de cómo diferentes comunidades de fe han enriquecido la sociedad.",
            "details": {
                "description_1": "En esta expedición académica única, los estudiantes exploran la notable diversidad religiosa de Panamá mientras obtienen una comprensión profunda de cómo diferentes comunidades de fe han enriquecido nuestra sociedad a lo largo de los siglos. Los estudiantes visitan templos representativos de varias religiones practicadas en Panamá, aprendiendo sobre la historia, creencias y contribuciones culturales de estas comunidades a través de interacción directa con líderes religiosos.",
                "description_2": "3 horas de exploración guiada disponible en Español e Inglés",
                "highlights_title": "Destacados",
                "highlights": [
                    {
                        "category": "Religiones Abrahámicas",
                        "items": "Catedral Ortodoxa Griega, Sinagoga Kol Shearith, Mezquita Jama Masjid, Templo Bahai Continental"
                    },
                    {
                        "category": "Religiones Orientales",
                        "items": "Templo Hindú de Panamá, Centro Cultural Internacional Soka Gakkai"
                    }
                ],
                "adaptations_title": "Adaptaciones Curriculares",
                "adaptations": [
                    {
                        "grade": "9º - 12º Grado",
                        "desc": "Analizar similitudes y diferencias en sistemas de creencias, examinar cómo las comunidades inmigrantes se adaptaron y evaluar cómo diferentes perspectivas religiosas abordan desafíos modernos."
                    }
                ]
            }
        }
    },
    "tours": {
        "hero": {
            "title": "Descubra las Historias Detrás de Panamá",
            "subtitle": "Tours privados guiados por expertos en historia. Vamos más allá de la superficie para revelar el rico contexto que forjó nuestra identidad cultural, para que logre entender a fondo Panamá, más allá de lo que se ve a simple vista.",
            "cta_primary": "Explore Nuestros Tours",
            "cta_secondary": "Contáctenos"
        },
        "audience": {
            "eyebrow": "Experiencias Privadas con Expertos",
            "title": "Diseñados para Cada Ocasión",
            "description": "Ya sea un viajero curioso, un planificador de bodas coordinando actividades para invitados, o anfitrión de visitantes VIP, creamos experiencias privadas que dejan impresiones duraderas.",
            "features": {
                "travelers": {
                    "title": "Viajeros Independientes y Familias.",
                    "desc": "Atención personalizada con flexibilidad para explorar a su propio ritmo y profundizar en los temas que despiertan su interés."
