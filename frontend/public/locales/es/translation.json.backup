                "wedding": {
                    "title": "Planificadores de Bodas y Eventos.",
                    "desc": "Actividades grupales memorables para invitados a bodas de destino—una forma única de mostrar el patrimonio de Panamá."
                },
                "corporate": {
                    "title": "Visitantes Corporativos y Misiones Diplomáticas.",
                    "desc": "Tours profesionales para asistentes a conferencias e invitados de embajadas, ofreciendo un contexto cultural significativo."
                }
            },
            "closing": "Cada tour es dirigido por un guía experto que da vida a la historia de Panamá a través de narrativas cautivadoras y profundo conocimiento local."
        },
        "highlights": {
            "title": "Más que Turismo",
            "subtitle": "Descubra qué hace únicas nuestras experiencias guiadas.",
            "features": {
                "context": {
                    "title": "Contexto Histórico Profundo",
                    "desc": "No nos limitamos a recitar fechas. Explicamos las fuerzas geopolíticas, sociales y económicas que moldearon la identidad de Panamá."
                },
                "private": {
                    "title": "Privado y Personalizado",
                    "desc": "Sin grupos compartidos. Su tour es exclusivamente para su grupo, permitiendo conversación significativa y flexibilidad."
                },
                "guides": {
                    "title": "Guías Expertos",
                    "desc": "Nuestros guías son especialistas en turismo histórico que dan vida al pasado con relatos locales que no encontrará en ninguna guía turística."
                }
            }
        },
        "grid": {
            "eyebrow": "Nuestros Tours",
            "title": "¿Qué Destino Le Gustaría Explorar?"
        },
        "canal": {
            "title": "Canal de Panamá: Esclusas de Miraflores",
            "desc": "Sea testigo del legendario Canal de Panamá en acción mientras enormes barcos navegan las históricas Esclusas de Miraflores—una hazaña de ingeniería que cambió el comercio global para siempre.",
            "details": {
                "title": "La Experiencia del Canal de Panamá",
                "description_1": "Ubíquese en el cruce del comercio mundial y sea testigo de uno de los mayores logros de ingeniería de la humanidad en pleno funcionamiento. En las Esclusas de Miraflores, observará maravillado cómo enormes barcos de carga y cruceros ascienden y descienden a través de las cámaras de las esclusas—una danza de agua y acero que desafía la gravedad y que ha conectado océanos por más de un siglo.",
                "description_2": "Aproximadamente 3 horas incluyendo película IMAX y observación de esclusas. Disponible en inglés y español.",
                "highlights_title": "Aspectos Destacados",
                "highlights": [
                    {
                        "title": "Tránsitos de Barcos en Vivo",
                        "desc": "Experimente la emoción de ver los buques navegar las esclusas en tiempo real. Su guía explicará el intrincado proceso mientras los barcos son elevados o descendidos 8 metros usando únicamente agua por gravedad del Lago Gatún."
                    },
                    {
                        "title": "La Historia Detrás del Canal",
                        "desc": "Descubra la dramática historia—desde el intento francés que terminó en tragedia hasta el triunfo estadounidense que reconfiguró el comercio global. Conozca cómo Panamá finalmente obtuvo la soberanía sobre esta vía estratégica."
                    },
                    {
                        "title": "Maravillas de Ingeniería",
                        "desc": "Comprenda cómo las esclusas originales de 1914 funcionan junto a las enormes nuevas esclusas Neopanamax inauguradas en 2016, que acomodan barcos tres veces más grandes que las originales."
                    },
                    {
                        "title": "Experiencia en Teatro IMAX",
                        "desc": "Sumérjase en la historia del canal a través de una impresionante película 3D de 45 minutos narrada por Morgan Freeman, que trae a la vida la historia y operación de esta maravilla de la ingeniería."
                    }
                ],
                "includes_title": "Qué Incluye",
                "includes": [
                    "Guía experto bilingüe",
                    "Entrada al centro de visitantes y teatro IMAX",
                    "Acceso a la plataforma de observación",
                    "Refrigerios durante el tour",
                    "Transporte privado opcional desde su hotel"
                ]
            }
        },
        "casco_plazas": {
            "title": "Casco Antiguo: Plazas e Iglesias",
            "desc": "Explore el distrito Patrimonio de la Humanidad donde plazas coloniales e iglesias históricas revelan el viaje de Panamá de colonia española a república independiente.",
            "details": {
                "title": "Plazas e Iglesias del Casco Antiguo",
                "description_1": "Adéntrese en un museo viviente donde cada plaza cuenta una historia y cada iglesia guarda siglos de secretos. El Casco Antiguo—el corazón histórico de Panamá y Patrimonio de la Humanidad por la UNESCO—se despliega ante usted mientras su guía revela las fascinantes historias detrás de su arquitectura colonial, desde la grandeza de la Catedral Metropolitana hasta el legendario Altar de Oro de la Iglesia de San José.",
                "description_2": "Aproximadamente 3 horas de recorrido a pie. Disponible en inglés y español.",
                "highlights_title": "Aspectos Destacados",
                "highlights": [
                    {
                        "title": "Plaza de la Independencia",
                        "desc": "Pise el mismo suelo donde Panamá declaró su independencia no una, sino dos veces—primero de España en 1821, luego de Colombia en 1903. Su guía trae estos momentos cruciales a la vida con el impresionante telón de fondo de la Catedral Metropolitana."
                    },
                    {
                        "title": "El Altar de Oro",
                        "desc": "Maravíllese ante el legendario altar de la Iglesia de San José, que según la leyenda fue salvado del pirata Henry Morgan mediante un ingenioso camuflaje de pintura negra. Descubra la verdad detrás de esta perdurable historia."
                    },
                    {
                        "title": "Plaza Bolívar",
                        "desc": "Visite la elegante plaza dedicada al Libertador, rodeada de arquitectura neoclásica y el histórico Hotel Colombia donde alguna vez se reunieron jefes de estado."
                    },
                    {
                        "title": "Joyas Arquitectónicas Ocultas",
                        "desc": "Explore las ruinas del Arco Chato, mansiones de influencia francesa y rincones tranquilos donde los estilos colonial, republicano y art déco se fusionan en armonía inesperada."
                    }
                ],
                "includes_title": "Qué Incluye",
                "includes": [
                    "Guía experto bilingüe",
                    "Entradas a las iglesias",
                    "Agua embotellada",
                    "Ritmo flexible para fotografía",
