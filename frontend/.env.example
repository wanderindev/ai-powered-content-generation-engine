# API URL for backend
VITE_API_URL=http://localhost:8000

# For production, use:
# VITE_API_URL=https://api.panamaincontext.com

# Sentry DSN for frontend error reporting (build-time; baked into the bundle).
# Find it at Sentry -> Settings -> Projects -> <frontend project> -> Client Keys (DSN).
# Unset in dev/CI -> Sentry init is a no-op. Override here (or via --build-arg)
# for staging/forks.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<frontend-project-id>

# Analytics (Google Analytics + Meta Pixel). Build-time only.
# VITE_ANALYTICS_ENABLED gates ALL gtag/fbq init and events — leave unset (OFF)
# in dev/CI/staging so non-prod traffic never reports to production properties.
# VITE_ANALYTICS_ENABLED=true
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=XXXXXXXXXXXXXXXX

# Cache-busting hash for translation files. Set automatically during the
# production Docker build (see docker/frontend/Dockerfile.prod); falls back
# to Date.now() in dev — no need to set it manually.
# VITE_BUILD_HASH=
