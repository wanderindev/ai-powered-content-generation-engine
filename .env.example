# Production environment template for docker-compose.prod.yml.
#
# Bootstrap on the droplet:
#   1. Copy this file to /home/wanderindev/pic/.env
#   2. Fill in real values (rotate from vendor consoles; never reuse pre-Phase-0 creds)
#   3. chmod 600 /home/wanderindev/pic/.env
#   4. docker-compose -f docker-compose.prod.yml up -d
#
# This file is committed; the real .env on the droplet is gitignored and must
# never be tracked. Variable names here must match what backend/app/core/config.py
# reads (pydantic-settings is case-insensitive).

# --- Application ---------------------------------------------------------------
DEBUG=false
# ENVIRONMENT gates Sentry init (events are never sent when "test")
# ENVIRONMENT=production

# --- Error reporting (Sentry) -------------------------------------------------
# Backend DSN. Find it at Sentry -> Settings -> Projects -> <backend project> ->
# Client Keys (DSN). Leave unset in CI/dev/forks -- Sentry init is a no-op then.
SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<backend-project-id>

# Analytics (Google Analytics + Meta Pixel). Both IDs and the master switch are
# build-time only. VITE_ANALYTICS_ENABLED gates ALL gtag/fbq init and events:
# leave it unset (OFF) in dev/CI/staging so non-prod traffic never reports to
# the production GA property or Meta Pixel (#112). The prod values are baked into
# docker/frontend/Dockerfile.prod; set them here only to test analytics locally.
# VITE_ANALYTICS_ENABLED=true
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=XXXXXXXXXXXXXXXX

# --- Database (DO Managed Postgres, sslmode=require) --------------------------
DATABASE_URL=postgresql://user:password@host:25060/dbname?sslmode=require

# --- CORS (JSON array, no surrounding quotes — docker env_file passes literally) ---
CORS_ORIGINS=["https://panamaincontext.com","https://www.panamaincontext.com","https://api.panamaincontext.com","https://public.panamaincontext.com"]

# --- Frontend / email addressing ----------------------------------------------
FRONTEND_URL=https://panamaincontext.com
ADMIN_NOTIFICATION_EMAIL=diego@panamaincontext.com
SENDER_EMAIL=diego@panamaincontext.com

# --- Admin auth (comma-separated list of authorized admin emails) --------------
ADMIN_EMAILS=admin@example.com

# --- Gmail integration ---------------------------------------------
SMTP_RELAY_HOST=smtp-relay.gmail.com
SMTP_RELAY_PORT=587
SMTP_RELAY_TIMEOUT=10

# --- Translation --------------------------------------------------------------
DEEPL_API=your-deepl-api-key

# --- LLM providers ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-key
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key

# --- ElevenLabs (voice narration for slide presentations) ----------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_DIEGO=your-elevenlabs-voice-id

# --- Instagram Graph API publishing --------------------------------------------
# Empty credentials = publisher disabled (publish endpoints answer 503, the
# scheduler no-ops; generate/render/schedule upstream still work).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_GRAPH_API_URL=https://graph.facebook.com/v23.0
# INSTAGRAM_SCHEDULER_ENABLED=true
# INSTAGRAM_SCHEDULER_INTERVAL_SECONDS=60

# --- DigitalOcean Spaces (S3-compatible object storage) -----------------------
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_BUCKET=panamaincontext
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_CDN_URL=https://panamaincontext.nyc3.digitaloceanspaces.com

# --- PayPal (webhook verification + checkout) ---------------------------------
# PAYPAL_API_URL defaults to sandbox; set to https://api-m.paypal.com in prod.
PAYPAL_API_URL=https://api-m.paypal.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_BUSINESS_EMAIL=diego@panamaincontext.com
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
