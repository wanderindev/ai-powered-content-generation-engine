{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-python.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/quality-gate.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(docker build:*)",
      "Bash(docker build *)",
      "Edit(CLAUDE.md)",
      "Edit(docs/claude/**)",
      "Edit(.claude/**)"
    ],
    "ask": [
      "Bash(docker push registry.digitalocean.com*)",
      "Bash(docker push *registry.digitalocean*)"
    ],
    "deny": [
      "Bash(*AVNS_*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard origin/*)",
      "Bash(git reset --hard HEAD~*)",
      "Bash(git filter-branch*)",
      "Bash(git rebase -i*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git clean -fd*)",
      "Bash(git clean -fx*)"
    ]
  }
}
